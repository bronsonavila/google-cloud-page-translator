# Copy to `.env.test` and fill in. The `pnpm test` script loads this file with
# `node --env-file-if-exists=.env.test` so Node and Vitest both see these variables.

# Required: HTTPS URL of the deployed translate function (must use the `VITE_` prefix for browser tests).
# Typical Cloud Run URL shape: https://SERVICE_NAME-PROJECT_NUMBER.REGION.run.app
# Example (not a real endpoint): https://translate-page-000000000000.us-west1.run.app
VITE_TRANSLATE_ENDPOINT=
